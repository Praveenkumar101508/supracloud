# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@supracloud.co.uk

# ── AI Voice Stack ─────────────────────────────────────────────────────────────
# Gemini 1.5 Flash — for Aria AI responses
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs Turbo v2.5 — for Aria TTS (ultra-low latency)
# Get key: https://elevenlabs.io
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Voice ID — default is "Sarah" (en-GB). Override with your custom voice.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Lead Storage (Supabase) ────────────────────────────────────────────────────
# Optional — falls back to email-only if not set
# Get credentials: https://supabase.com
# Run: CREATE TABLE aria_leads (id uuid default gen_random_uuid() primary key,
#   name text, email text, company text, role text, challenge text,
#   volume text, timeframe text, source_url text, created_at timestamptz);
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# ── Google Calendar Booking Engine ────────────────────────────────────────────
# Service Account (no OAuth2 needed — service account has domain-wide delegation
# or is shared on the calendar). Create at: console.cloud.google.com → IAM → Service Accounts
# Download JSON key, copy client_email and private_key values below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=supracloud-booking@your-project.iam.gserviceaccount.com
# Keep newlines as literal \n (single line). Starts with -----BEGIN RSA PRIVATE KEY-----
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
# The calendar ID to book into — use "primary" or a specific calendar email
GOOGLE_CALENDAR_ID=primary

# ── Analytics (PostHog) ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://supracloud.co.uk
